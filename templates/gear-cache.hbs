<form class="sla-gear-cache-form">
  <div class="sla-gear-cache-grid">
    <div class="sla-gear-cache-field">
      <label>Cache Type</label>
      <select name="cacheType">
        {{#each cacheTypes}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="sla-gear-cache-field">
      <label>Items To Roll</label>
      <input type="number" name="itemCount" min="1" max="6" value="{{state.itemCount}}">
    </div>
  </div>

  <div class="sla-gear-cache-list">
    <h3>Generated Cache</h3>
    {{#if items.length}}
      <ul>
        {{#each items}}
          <li>{{name}} x{{quantity}} | {{weight}} kg | {{cost}} cR</li>
        {{/each}}
      </ul>
      <p><strong>Total Weight:</strong> {{totals.weight}} kg | <strong>Total Value:</strong> {{totals.cost}} cR</p>
    {{else}}
      <p>No cache generated yet.</p>
    {{/if}}
  </div>

  <div class="sla-gear-cache-actions">
    <button type="button" data-action="randomize">Randomize Cache</button>
    <button type="button" data-action="chat">Post To Chat</button>
    <button type="button" data-action="actor">Add To Selected Actor</button>
    <button type="submit">Save Cache</button>
  </div>
</form>
